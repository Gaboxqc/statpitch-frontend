# Where the API lives. In production this is the real origin, and the app is
# served from the same registrable domain so the session cookie is sent.
VITE_API_URL=https://api.gabrielmayorga.dev/statpitch

# Local development only. Uncomment both lines to route API calls through the
# Vite dev server, which is what makes signing in work on localhost — see the
# comment in vite.config.ts for why a direct call cannot.
# VITE_API_URL=/api/statpitch
# VITE_API_PROXY_TARGET=https://api.gabrielmayorga.dev
